/skills/PROJECT_BASE_ADAPTER.json text eol=lf
/skills/PROJECT_SKILL_SNAPSHOT.json text eol=lf
/skills/SKILL_REGISTRY.json text eol=lf

# Generated PDF deliverables are binary artifacts.  Their render/metadata checks
# are recorded separately; never feed their internal streams to text whitespace checks.
exports/*.pdf -diff
output/pdf/*.pdf -diff

# Native crash receipts bind original log bytes across Windows/Linux checkouts.
evidence/runtime/native-exit-20260913/*.log -text
# Preserve engine-emitted trailing blank lines without hiding other whitespace errors.
evidence/runtime/exported-route-book-20260913/*.log -text whitespace=-blank-at-eof
evidence/runtime/audio-cue-20260913/*.log -text whitespace=-blank-at-eof
evidence/runtime/tutorial-audio-20260913/*.log -text whitespace=-blank-at-eof
evidence/runtime/product-speed-20260913/*.log -text whitespace=-blank-at-eof
# Windows raw engine receipts preserve CRLF, including the engine's final blank line.
evidence/runtime/rb08-tradeoff-20260914/*.log -text whitespace=cr-at-eol,-blank-at-eof
evidence/runtime/product-speed-20260913/completion/*.log -text whitespace=-blank-at-eof
evidence/runtime/native-generator-lifetime-20260913/*.log -text whitespace=-blank-at-eof
# CDB emits CRLF and padded stack arguments; retain this exact diagnostic output.
evidence/runtime/native-generator-lifetime-20260913/diagnostic-source-stack.log -text -whitespace
evidence/runtime/native-generator-lifetime-20260913/frame-source-drain.log -text whitespace=cr-at-eol
