; Engine configuration file.
; Edit through the Godot editor when possible.
;
; Format:
;   [section]
;   param=value

config_version=5

[application]

config/name="Switchy Express: Cargo Puzzle"
run/main_scene="res://game/main/main.tscn"
run/main_scene.validation_harness="res://tools/validation/finite/finite_validation_launcher.tscn"
run/main_scene.vertical_slice_demo="res://game/demo/vertical_slice_demo.tscn"

[display]

[display/window]

size/viewport_width=1920
size/viewport_height=1080
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
handheld/orientation=0

